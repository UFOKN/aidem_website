---
import Layout from "../layouts/Layout.astro";
import MapHeader from "../components/MapHeader.astro";
import TryTheDemo from "../components/TryTheDemo.astro";
import Delivers from "../components/Delivers.astro";
import Capabilities from "../components/Capabilities.astro";
import { SITE_NAME, TAGLINE } from "../site";

const statement =
  "We develop and scale an agentic AI decision support system for flood-triggered compound hazard mitigation.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Project",
  name: SITE_NAME,
  alternateName: TAGLINE,
  url: Astro.site?.href,
  description: statement,
  funder: [
    { "@type": "Organization", name: "Google.org" },
    { "@type": "Organization", name: "National Science Foundation" },
  ],
};
---

<Layout
  title={TAGLINE}
  description="We transform government response from reactive and siloed to proactive and collaborative."
  callToActionAfter="#capabilities"
  callToActionText="Help us shape AidEM: pilot it with your organization or join the team"
  callToActionLabel="Get in touch"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>
  <MapHeader
    title={TAGLINE}
    text="We transform government response from reactive and siloed to proactive and collaborative."
  />
  <TryTheDemo />
  <Delivers />
  <Capabilities />
</Layout>
