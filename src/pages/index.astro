---
import Layout from "../layouts/Layout.astro";
import HomepageHeader from "../components/HomepageHeader.astro";
import TryTheDemo from "../components/TryTheDemo.astro";
import Capabilities from "../components/Capabilities.astro";
import Solutions from "../components/Solutions.astro";
import { SITE_NAME, TAGLINE } from "../site";

const statement =
  "We develop and scale an agentic AI decision support system for flood-triggered compound hazard mitigation.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Project",
  name: SITE_NAME,
  alternateName: TAGLINE,
  url: Astro.site?.href,
  description: statement,
  funder: [
    { "@type": "Organization", name: "Google.org" },
    { "@type": "Organization", name: "National Science Foundation" },
  ],
};
---

<Layout
  title="Where flooding strikes, disruptions follow."
  description={statement}
  callToActionAfter="#solutions"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd)}
    />
  </Fragment>
  <HomepageHeader />
  <TryTheDemo />
  <Capabilities />
  <Solutions />
</Layout>
