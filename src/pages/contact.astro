---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import { ObfuscatedEmail } from "astro-obfuscate/components";
---

<Layout
  showUseOurData={false}
  title="Get in Touch"
  description="Talk to our team about how we can support your data needs in flood impact forecasting and energy."
>
  <section>
    <div>
      <h2>We’d love to meet you.</h2>
      <p>Talk to our team about how we can support your data needs!</p>
      <dl>
        <dt>Email</dt>
        <dd>
          <ObfuscatedEmail email="contact@data2action.tech" />
        </dd>
        <!-- <dt>LinkedIn</dt>
        <dd>[Do you have this?]</dd>
        <dt>Other Social Media</dt>
        <dd>[Do you have this?]</dd> -->
      </dl>
    </div>
    <div class="pt-10 md:pt-4 max-md:bg-[#E6EBF0] max-md:dot-grid max-md:[--dot-grid-color:#C4C8CC] max-md:-mb-20 max-md:!pb-20">
      <h3 class="md:hidden">Send us a message</h3>
      <ContactForm />
    </div>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";

  section {
    @apply grid-area-full md:grid-area-text mt-15 py-20 md:grid md:grid-cols-2 md:gap-10;
  }

  div {
    @apply flex flex-col gap-10 max-md:p-10;
  }

  p {
    @apply text-lg md:text-xl text-balance;
  }

  dt {
    @apply text-sm uppercase tracking-wider text-[var(--color-text-secondary)];
  }
  dd {
    @apply md:text-lg mb-6;
  }
</style>
