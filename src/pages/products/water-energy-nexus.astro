---
import { Picture } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import CallToAction from "../../components/CallToAction.astro";
import Section from "../../components/Section.astro";
import Cards from "../../components/Cards.astro";
import Solutions from "../../components/Solutions.astro";
import MapCredit from "../../components/MapCredit.astro";
import HeaderImage from "../../assets/content-images/wen-header.jpg";
import HeaderForegroundImage from "../../assets/content-images/wen-header-foreground.png";
import CtaImage from "../../assets/content-images/wen-cta.png";
import WENImage from "../../assets/content-images/wen-card.jpg";

const useCases = [
  {
    title: "Threat",
    description:
      "What are the current and future threats to water and energy infrastructure?",
  },
  {
    title: "Water and energy demand",
    description: "How much is being used, where and for what purpose?",
  },
  {
    title: "Water Supply",
    description:
      "What are the current and future threats to water availability to meet water and energy needs?",
  },
  {
    title: "Rules & Regulations",
    description:
      "Which rules and regulations currently support integrated thinking about the water and energy nexus?",
  },
];
---

<Layout
  title="Water-Energy Nexus"
  description="Our next-generation data infrastructure connects water and energy data and answers questions at their nexus"
  ogImage={WENImage}
>
  <section id="header">
    <div id="header-desc">
      <h2>Water-Energy Nexus</h2>
      <p>
        Our next-generation data infrastructure connects water and energy data
        and answers questions at their nexus
      </p>
    </div>
    <div id="header-fg">
      <Picture
        src={HeaderForegroundImage}
        alt="Messages from a chat application reading 'Find all dams located upstream of the power station in Wayne County, NC' and 'Retrieve all power stations in Ohio at risk of flooding today'"
        quality="max"
        width={495}
        height={238}
        layout="constrained"
        priority
      />
    </div>
    <div id="header-bg">
      <Picture src={HeaderImage} alt="" quality="high" />
    </div>
    <MapCredit />
  </section>
  <CallToAction
    text="Try the demo"
    description="Our data is available via API, bespoke solutions, and natural language interface. Ask a question!"
    href="https://deep-wenokn.streamlit.app/"
    label="Launch demo"
    prevSibling="#header"
    nextSibling="#use-cases"
    image={CtaImage}
    imageAlt="Screenshot of an AI chat interface showing the results of prompts like 'Show all power stations in Ohio'"
  />
  <Section
    title="Use Cases"
    id="use-cases"
    style="dot-grid [--dot-grid-color:#D9D9D9] spacer-top"
  >
    <Cards items={useCases} />
  </Section>
  <Solutions />
</Layout>

<style>
  @reference "../../styles/global.css";

  #header {
    @apply grid-area-full bg-[#F6E9FC] grid grid-cols-subgrid relative overflow-hidden gap-10;

    #header-desc {
      @apply grid-area-main md:grid-area-text mt-[120px] flex flex-col gap-5 items-center z-2;

      h2 {
        @apply text-center;
      }

      p {
        @apply grid-area-text text-black text-xl text-center text-balance opacity-70 max-w-[50ch];
      }
    }

    #header-fg {
      @apply grid-area-full md:grid-area-main z-3 flex justify-center max-md:mt-20 md:mb-10;

      img {
      }
    }
    #header-bg {
      @apply contents;

      picture {
        @apply w-full h-full absolute top-0 left-0 z-1 object-cover max-md:aspect-square;

        img {
          @apply h-full object-cover;
        }
      }
    }
  }
</style>
