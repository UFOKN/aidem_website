---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import CallToAction from "../../components/CallToAction.astro";
import Section from "../../components/Section.astro";
import Cards from "../../components/Cards.astro";
import Products from "../../components/Products.astro";
import HeaderImage from "../../assets/content-images/solutions-business-header.jpg";

const useCases = [
  {
    title: "Homeowners and Real-Estate Developers",
    description:
      "Is my home at risk of flooding today? Tomorrow? Should this area be developed for real estate?",
  },
  {
    title: "Insurance",
    description: "What is the flood risk in this neighborhood?",
  },
  {
    title: "Weather Forecasters",
    description: "Include real-time flood forecasts in weather forecasts.",
  },
  {
    title: "Logistics, Supply Chains and Transportation",
    description: "Is the planned truck/train route at risk of flooding?",
  },
  {
    title: "Stormwater Management",
    description: "Are we likely to lose power?",
  },
  {
    title: "Utilities",
    description: "What disruptions should we anticipate?",
  },
];
---

<Layout
  title="Solutions for Business"
  description="We provide bespoke solutions and standardized data for your applications — in the format and resolution you need."
  ogImage={HeaderImage}
>
  <PageHeader
    title="Solutions for Businesses"
    image={HeaderImage}
    imageAlt="A utility worker in a hard hat and safety vest photographed evaluating flood impact in a flooded urban landscape."
  />
  <CallToAction
    text="We provide standardized data for your applications — in the format and resolution you need."
    prevSibling="#header"
    nextSibling="#use-cases"
  />
  <Section title="Use Cases" id="use-cases" style="spacer-top">
    <Cards items={useCases} />
  </Section>
  <Products />
</Layout>
