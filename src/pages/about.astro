---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import OurTechnology from "../components/OurTechnology.svelte";
import { Image } from "astro:assets";
import LilitPortrait from "../assets/content-images/team/lilit-yeghiazarian.jpg";
import EricPortrait from "../assets/content-images/team/eric-welch.jpg";
import IlyaPortrait from "../assets/content-images/team/ilya-zaslavsky.jpg";
import JordanPortrait from "../assets/content-images/team/jordan-mcmaster.jpg";

// Leads have portraits (from aid-em.org); other members are listed below them
const leads = [
  {
    name: "Lilit Yeghiazarian",
    role: "Project Lead, University of Cincinnati",
    portrait: LilitPortrait,
  },
  {
    name: "Eric Welch",
    role: "Engagement Lead, School of Public Affairs, Arizona State University",
    portrait: EricPortrait,
  },
  {
    name: "Ilya Zaslavsky",
    role: "Director, Spatial Information Systems Lab, University of California San Diego",
    portrait: IlyaPortrait,
  },
  {
    name: "Jordan McMaster",
    role: "Economist / Consequences Specialist, US Army Corps of Engineers",
    portrait: JordanPortrait,
  },
];
const members = [
  "Adam Shepherd",
  "Susie [last name]",
  "Sadegh [last name]",
  "Kai [last name]",
  "Johnny [last name]",
  "Philipp Schmitt",
];
---

<Layout
  title="About"
  description="We're a multidisciplinary team of researchers, engineers, computer scientists and emergency management experts bringing decades of experience to AI-supported disaster mitigation."
>
  <PageHeader title="About" />
  <div id="blockquote">
    <p>
      We’re a multidisciplinary team of researchers, engineers, computer
      scientists and emergency management experts, bringing decades of
      experience to AI-supported disaster mitigation.
    </p>
  </div>
  <section id="mission">
    <h3>Our mission</h3>
    <div>
      <p>
        We build on many years of research in water and energy resources, data
        and systems science, AI, infrastructure resilience, environmental
        engineering, policy, and user-centered design.
      </p>
      <p>
        AidEM moves government hazard management from reactive and siloed to
        proactive and aware of how infrastructure, physical, social, technical
        and informational systems depend on each other. It helps the U.S. Army
        Corps of Engineers anticipate primary, secondary, and tertiary cascading
        failures and their impacts before they occur.
      </p>
      <p>
        A better understanding of these impacts helps shape evacuations, reduces
        the potential for life loss before, during, and after a disaster, and
        lets agencies direct recovery resources to the people affected by
        community-wide outages.
      </p>
    </div>
  </section>
  <section id="members">
    <h3>Our team</h3>
    <ul>
      {leads.map((person) => (
        <li class="lead">
          <Image
            src={person.portrait}
            alt=""
            width={160}
            height={160}
            class="portrait"
          />
          <div>
            <strong>{person.name}</strong>
            <span>{person.role}</span>
          </div>
        </li>
      ))}
    </ul>
    <ul class="others">
      {members.map((name) => (
        <li>{name}</li>
      ))}
    </ul>
  </section>
  <section id="funding">
    <h3>Funding</h3>
    <p>
      AidEM is a nonprofit organization at the University of Cincinnati Research
      Institute. We are supported by Google.org and the National Science
      Foundation’s Convergence Accelerator and Proto-OKN programs.
    </p>
  </section>
  <OurTechnology client:visible />
</Layout>

<style>
  @reference "../styles/global.css";

  #blockquote {
    @apply grid-area-full bg-[#E6EBF0] dot-grid [--dot-grid-color:#C4C8CC] grid grid-cols-subgrid gap-y-8 py-9 md:py-18;

    p {
      @apply grid-area-text text-xl md:text-[2.125rem];
    }
  }

  section {
    @apply grid-area-text grid grid-cols-1 gap-10 md:grid-cols-2 py-20;

    h3 {
      grid-area: initial;
    }

    p {
      @apply text-lg opacity-65;
    }
  }

  #members,
  #funding {
    @apply border-t border-[#E6EBF0];
  }

  #mission div {
    @apply flex flex-col gap-4;
  }

  #members {
    @apply gap-y-6;
  }

  ul {
    @apply flex flex-col gap-6;
  }

  /* Other members: two columns under a rule, lighter than the leads */
  ul.others {
    @apply md:col-start-2 grid grid-cols-1 sm:grid-cols-2 sm:grid-rows-3 sm:grid-flow-col gap-x-10 gap-y-2 border-t border-black/15 pt-[58px] mt-11;

    li {
      @apply opacity-80 text-[1.0625rem] leading-[1.4];
    }
  }

  li {
    @apply text-lg;

    strong {
      @apply font-[600];
    }

    span {
      @apply block opacity-65;
    }

    &.lead {
      @apply flex items-center gap-5;
    }
  }

  .portrait {
    @apply size-20 shrink-0 object-cover bg-[#E6EBF0];
  }
</style>
