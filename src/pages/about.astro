---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import OurTechnology from "../components/OurTechnology.svelte";

// The first four have portraits (placeholders until photos are added)
const leads = [
  {
    name: "Lilit Yeghiazarian",
    role: "Project Lead, University of Cincinnati",
  },
  {
    name: "Eric Welch",
    role: "Engagement Lead, School of Public Affairs, Arizona State University",
  },
  {
    name: "Ilya Zaslavsky",
    role: "Director, Spatial Information Systems Lab, University of California San Diego",
  },
  {
    name: "Jordan McMaster",
    role: "Economist / Consequences Specialist, US Army Corps of Engineers",
  },
];
const members = ["Adam", "Susie", "Sadegh", "Kai", "Johnny", "Philipp"];
---

<Layout
  title="About"
  callToActionAfter="#investors-funding"
  description="We're a multidisciplinary team of researchers, engineers, computer scientists and emergency management experts working together to advance AI-driven disaster mitigation."
>
  <PageHeader title="About" />
  <div id="blockquote">
    <p>
      A multidisciplinary team of researchers, engineers, computer scientists
      and emergency management experts working together to advance AI-driven
      disaster mitigation.
    </p>
  </div>
  <section id="mission">
    <h3>Our mission</h3>
    <div>
      <p>
        We bring to market products developed in decades of research in water
        and energy resources, data and systems science, AI, infrastructure
        resilience, environmental engineering, policy, and user-centered design.
      </p>
      <p>
        AidEM moves government hazard management from reactive and siloed to
        proactive and aware of how infrastructure, physical, social, technical
        and informational systems depend on each other. It helps the U.S. Army
        Corps of Engineers anticipate primary, secondary, and tertiary cascading
        failures and their impacts before they occur.
      </p>
      <p>
        A better understanding of these impacts helps shape evacuations, reduces
        the potential for life loss before, during, and after a disaster, and
        lets agencies direct recovery resources to the people affected by
        community-wide outages.
      </p>
    </div>
  </section>
  <section id="members">
    <h3>Our team</h3>
    <ul>
      {leads.map((person) => (
        <li class="lead">
          <div class="portrait" aria-hidden="true" />
          <div>
            <strong>{person.name}</strong>
            <span>{person.role}</span>
          </div>
        </li>
      ))}
      {members.map((name) => (
        <li>
          <strong>{name}</strong>
        </li>
      ))}
    </ul>
  </section>
  <OurTechnology client:visible />
  <section id="investors-funding">
    <div>
      <h3>Investors</h3>
      <a href="/contact">Get in touch</a>
    </div>
    <div>
      <h3>Funding</h3>
      <p>
        We are supported by Google.org and the National Science Foundation’s
        Convergence Accelerator and Proto-OKN programs.
      </p>
    </div>
  </section>
</Layout>

<style>
  @reference "../styles/global.css";

  #blockquote {
    @apply grid-area-full bg-[#E6EBF0] dot-grid [--dot-grid-color:#C4C8CC] grid grid-cols-subgrid gap-y-8 py-9 md:py-18;

    p {
      @apply grid-area-text text-xl md:text-[2.125rem];
    }
  }

  section {
    @apply grid-area-text grid grid-cols-1 gap-10 md:grid-cols-2 py-20;

    h3 {
      grid-area: initial;
    }

    p {
      @apply text-lg opacity-65;
    }
  }

  #members {
    @apply border-t border-[#E6EBF0];
  }

  #mission div,
  #investors-funding div {
    @apply flex flex-col gap-4;
  }

  ul {
    @apply flex flex-col gap-6;
  }

  li {
    @apply text-lg;

    strong {
      @apply font-[600];
    }

    span {
      @apply block opacity-65;
    }

    &.lead {
      @apply flex items-center gap-5;
    }
  }

  .portrait {
    @apply size-20 shrink-0 rounded-full bg-[#E6EBF0];
  }
</style>
