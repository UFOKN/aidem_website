---
import Section from "./Section.astro";

const outcomes = [
  {
    title: "Proactive Decision Support",
    description:
      "Plain-language queries return impact timelines, infrastructure failure sequences and risk assessments before a disaster strikes.",
  },
  {
    title: "Cascading Failure Analysis",
    description:
      "Anticipate primary, secondary and tertiary failures as flooding propagates across power, water, transportation and communication systems.",
  },
  {
    title: "Life Safety and Evacuation",
    description:
      "Clear information on flood extent and impacts to support evacuation decisions and reduce the potential for loss of life before, during and after an event.",
  },
  {
    title: "Resource Optimization",
    description:
      "Quantify populations at risk, so agencies can direct response and recovery resources where they are needed most.",
  },
];
---

<Section title="What AidEM Delivers" id="delivers" style="spacer-top">
  <p class="intro">
    Floods are becoming more frequent and many U.S. dams are aging. When one
    fails, the damage spreads: a flooded substation cuts power to a water plant,
    and the water plant can no longer supply a hospital. AidEM helps agencies
    see these chains before they happen.
  </p>
  <ul>
    {outcomes.map(({ title, description }) => (
      <li>
        <h4>{title}</h4>
        <p>{description}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  @reference "../styles/global.css";

  .intro {
    @apply grid-area-text text-lg -mt-4;
  }

  ul {
    @apply grid-area-main grid grid-cols-1 md:grid-cols-2 gap-10;
  }

  li {
    @apply bg-[#E4E9EE] p-5 md:p-10 flex flex-col gap-3;
  }

  h4 {
    @apply text-lg md:text-xl;
  }
</style>
