---
import Section from "./Section.astro";

const outcomes = [
  {
    title: "Proactive Decision Support",
    description:
      "Plain-language queries return actionable mission impact timelines, infrastructure failure sequences, and risk assessments before disasters strike.",
  },
  {
    title: "Compound Hazard Modeling",
    description:
      "Anticipates primary, secondary, and tertiary cascading failures across infrastructure, physical, social, technical, and informational systems.",
  },
  {
    title: "Life Safety & Evacuation",
    description:
      "Improves the knowledge environment around flooding to shape evacuations and reduce the potential for life loss pre-, during, and post-disaster.",
  },
  {
    title: "Resource Optimization",
    description:
      "Enables agencies to more efficiently distribute recovery resources and understand the full magnitude of the impacted population.",
  },
];
---

<Section title="What AidEM Delivers" id="delivers" style="spacer-top">
  <ul>
    {outcomes.map(({ title, description }) => (
      <li>
        <h4>{title}</h4>
        <p>{description}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  @reference "../styles/global.css";

  ul {
    @apply grid-area-main grid grid-cols-1 md:grid-cols-2 gap-10;
  }

  li {
    @apply bg-[#E4E9EE] p-5 md:p-10 flex flex-col gap-3;
  }

  h4 {
    @apply text-lg md:text-xl;
  }
</style>
