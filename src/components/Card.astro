---
import { Picture } from "astro:assets";
const {
  title,
  description,
  items,
  itemsLabel,
  link,
  image,
  style = "",
} = Astro.props;

const cardType = title && description ? "card-default" : "card-compact";

// Generate a random short UUID for aria
const titleID = crypto.randomUUID().slice(0, 6);
---

<li class={`card ${cardType} ${style}`}>
  {image && <Picture src={image} alt="" />}
  <div>
    <h4 id={titleID}>{title}</h4>
    {description && <p>{description}</p>}
    {items && (
      <div class="items">
        {itemsLabel && <span class="items-label">{itemsLabel}</span>}
        <ul>
          {items.map((item: string) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )}
    {link && (
      <a href={link} aria-describedby={titleID}>
        Learn more
      </a>
    )}
  </div>
</li>

<style>
  @reference "../styles/global.css";

  .items {
    @apply flex flex-col gap-3 text-lg md:text-xl;
  }

  .items-label {
    @apply text-sm uppercase tracking-wider;
  }

  .card {
    @apply bg-[#E4E9EE] relative flex flex-col transition-all ease-in-out duration-300;
  }

  .card > div {
    @apply p-5 md:p-10 flex flex-col gap-3;
  }

  h4 {
    @apply text-lg md:text-xl;
  }

  p {
    @apply opacity-65;
  }

  a {
    @apply mt-auto uppercase tracking-wide text-sm opacity-70;
  }

  a::after {
    @apply content-[""] absolute w-full h-full z-3 top-0 left-0;
  }

  .card-default:has(img) > div {
    @apply bg-white h-auto grow;
  }

  .card-compact {
    img {
      @apply absolute w-full h-full object-cover z-1;
    }
    > div {
      @apply h-full justify-between aspect-[5/4] relative z-2;
    }
  }
</style>
