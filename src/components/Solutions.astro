---
import Section from "./Section.astro";
import Cards from "./Cards.astro";
import SolutionsGovtImage from "../assets/content-images/solutions-govt-card.jpg";
import SolutionsBusinessImage from "../assets/content-images/solutions-business-card.jpg";

const cards = [
  {
    title: "For Government",
    image: SolutionsGovtImage,
    itemsLabel: "Use cases",
    items: ["Planning", "Tabletop exercises"],
  },
  {
    title: "For Emergency Managers",
    image: SolutionsBusinessImage,
    itemsLabel: "Use cases",
    items: ["Tabletop exercises", "Real-time response and mitigation"],
  },
];
---

<Section title="Solutions" id="solutions">
  <Cards items={cards} />
</Section>
