---
import ButtonLink from "./ButtonLink.astro";
---

<ul id="menu-ul">
  <li>
    <a href="/team">Team</a>
  </li>
  <li class="button">
    <ButtonLink
      label="Get in touch"
      href="/contact"
      showArrow={false}
      style="!h-9"
    />
  </li>
</ul>

<style>
  @reference "../styles/global.css";

  #menu-ul {
    @apply flex items-center gap-1 bg-white/70 backdrop-blur-xs h-10 py-0.5 pr-0.5 pl-1 z-10;
  }

  li:not(.button) {
    @apply hover:bg-white h-9 items-center flex transition-all font-[450] text-[1.0625rem];

    a {
      @apply h-full flex items-center px-3 hover:opacity-100;
    }
  }
</style>
