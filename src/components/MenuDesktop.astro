---
// Hover behavior copied from data2action.tech: the hovered item turns white,
// the others dim, and a dark gradient fades in behind the header.
---

<div class="flex justify-center">
  <ul id="menu-ul">
    <li>
      <a href="/">Home</a>
    </li>
    <li>
      <a href="/about">About</a>
    </li>
    <li>
      <a href="/contact">Get in touch</a>
    </li>
  </ul>
</div>

<style>
  @reference "../styles/global.css";

  #menu-ul {
    @apply flex items-center bg-white/45 backdrop-blur-xs h-10 z-10;

    &:has(:hover) > li:not(:hover) {
      @apply opacity-70 bg-[#D7DEE4];
    }
  }

  div::before {
    @apply absolute left-0 top-0 right-0 z-8 block h-80 bg-gradient-to-b from-[#0A131C]/30 to-[#0A131C]/0 transition-opacity;
    content: " ";
    opacity: 0;
    pointer-events: none;
  }

  div:has(:hover)::before {
    opacity: 1;
  }

  li {
    @apply hover:bg-white h-full items-center flex transition-all font-[450] text-[1.0625rem];

    a {
      @apply h-full flex items-center px-3 hover:opacity-100;
    }
  }
</style>
