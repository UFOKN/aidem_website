---
import ButtonLink from "./ButtonLink.astro";
---

<ul id="menu-ul">
  <li>
    <a href="/">Home</a>
  </li>
  <li>
    <a href="/about">About</a>
  </li>
  <li class="button">
    <ButtonLink
      label="Get in touch"
      href="/contact"
      showArrow={false}
      style="!h-9 !normal-case !tracking-normal !font-[450] !text-[1.0625rem]"
    />
  </li>
</ul>

<style>
  @reference "../styles/global.css";

  #menu-ul {
    @apply flex items-center gap-1 bg-white/70 backdrop-blur-xs h-10 py-0.5 pr-0.5 pl-1 z-10;

    /* Dim the other items while one is hovered (as on data2action.tech) */
    &:has(:hover) > li:not(:hover) {
      @apply opacity-70 bg-[#D7DEE4];
    }
  }

  li {
    @apply transition-all;
  }

  li:not(.button) {
    @apply hover:bg-white h-9 items-center flex transition-all font-[450] text-[1.0625rem];

    a {
      @apply h-full flex items-center px-3 hover:opacity-100;
    }
  }
</style>
