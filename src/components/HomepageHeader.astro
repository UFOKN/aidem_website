---
import { Picture } from "astro:assets";
import bgImage from "../assets/homepage-header-bg.jpg";
import MapCredit from "./MapCredit.astro";
import HomePageHeaderIllustration from "./HomepageHeaderIllustration.astro";
import HomepageHeaderIllustrationLabel from "./HomepageHeaderIllustrationLabel.astro";
import HomepageHeaderIllustrationCircle from "./HomepageHeaderIllustrationCircle.astro";

const mapElements = [
  {
    asset: "Cell Tower",
    disruption: "Service Disruption",
    x: 8.4,
    y: 61.8,
    radius: 1000,
    delay: 1000,
    color: "#ECB024",
  },
  {
    asset: "Water Treatment Facility",
    disruption: "Power Loss",
    x: 45.4,
    y: 28.6,
    radius: 1250,
    delay: 2250,
    color: "#FF5500",
  },
  {
    asset: "Hospital",
    disruption: "Loss of Drinking Water",
    x: 81,
    y: 5.4,
    radius: 600,
    delay: 3150,
    color: "#FF0000",
  },
  {
    asset: "Power Station",
    disruption: "Flood Zone",
    x: 75,
    y: 54,
    radius: 600,
    color: "#0066FF",
  },
  // Second power station circle
  {
    x: 75,
    y: 54,
    delay: 1500,
    radius: 600,
    color: "#0066FF",
  },
];
---

<section id="header">
  <div id="wrapper">
    <div id="text">
      <h2>
        Where flooding strikes, disruptions follow.{" "}
        <span>Predict both. Act sooner.</span>
      </h2>
    </div>
    <div id="image-wrapper">
      <div id="background-image">
        <Picture
          src={bgImage}
          alt="A map of an urban area with flooding near a river. From a power station in the flood zone arrows are pointing to a cell tower, a water treatment facility and a hospital, indicating cascading disruptions caused by flooding even where the water doesnt't reach."
          layout="constrained"
          width={2340}
          height={1200}
          quality={"high"}
          priority
        />
      </div>

      <div id="circles">
        {mapElements.map((element) => (
          <HomepageHeaderIllustrationCircle
            x={element.x}
            y={element.y}
            radius={element.radius}
            delay={element.delay}
            color={element.color}
          />
        ))}
      </div>
      <div id="labels">
        {mapElements.map((element) => (
          <HomepageHeaderIllustrationLabel
            asset={element.asset}
            disruption={element.disruption}
            x={element.x}
            y={element.y}
          />
        ))}
      </div>
      <div id="svg-image">
        <HomePageHeaderIllustration />
      </div>
    </div>
  </div>
  <MapCredit />
</section>

<style>
  @reference "../styles/global.css";

  #header {
    @apply grid-area-full grid-cols-subgrid grid pt-8 md:pt-15 z-2 overflow-clip bg-[#ECEDEE];
  }

  #wrapper {
    @apply pt-20 pb-0 2xl:px-20 grid-area-main md:grid-area-text flex flex-col lg:flex-row justify-between items-center lg:items-start;
  }

  #text {
    @apply z-2 lg:-mr-70 w-full;
  }

  #image-wrapper {
    @apply w-full max-w-[500px] aspect-square relative max-md:-mt-0 mt-5 lg:mt-10 lg:mt-0 z-1 md:max-lg:-mr-[25vw] -mb-3;
  }

  #background-image {
    @apply w-[468%] h-[240%] ml-[-276%] mt-[-92%] absolute;
  }

  #svg-image {
    @apply z-2 w-full h-full absolute;
  }

  #labels {
    @apply z-3 absolute w-full h-full;
  }

  #circles {
    @apply z-2 absolute w-full h-full;

    /* Set B */
    mix-blend-mode: plus-lighter;
    opacity: 0.4;
  }

  h2 {
    @apply md:max-lg:-mb-[2em] max-md:font-[450];

    span {
      @apply mt-[.4em] block;
    }
  }
</style>
