---
import Wordmark from "./Wordmark.astro";
import { PROTOTYPE_URL, TAGLINE, url } from "../site";
---

<footer>
  <div class="grid-area-text flex flex-col items-start gap-5 mt-[70px]">
    <Wordmark />
    <span class="text-[#D6E3FF]">{TAGLINE}</span>
  </div>
  <div id="nav">
    <dl>
      <dt>AidEM</dt>
      <dd>
        <a href={PROTOTYPE_URL} target="_blank">
          Explore AidEM
        </a>
      </dd>
      <dd>
        <a href={url("/contact")}>Schedule a demo</a>
      </dd>
    </dl>
    <dl>
      <dt>About</dt>
      <dd>
        <a href={url("/about")}>About</a>
      </dd>
      <dd>
        <a href={url("/contact")}>Contact</a>
      </dd>
    </dl>
  </div>
  <p class="grid-area-text text-[#C9DCFF] text-xs py-4 border-t-1 border-[#4b7fe0]">
    © 2026 AidEM. All rights reserved.
  </p>

  <style>
    @reference "../styles/global.css";

    footer {
      @apply grid-area-full gap-y-14 grid grid-cols-subgrid text-white;
      background-color: #1056d7;
    }

    #nav {
      @apply grid-area-text grid grid-cols-1 md:grid-cols-3 gap-10;
    }

    dl {
      @apply flex flex-col gap-2;
    }

    dt {
      @apply text-[#D6E3FF] text-sm uppercase tracking-wider;
    }

    dd a {
      @apply py-2 h-auto;
    }
  </style>
</footer>
