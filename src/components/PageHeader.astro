---
import { Picture } from "astro:assets";
const { title, image, imageAlt } = Astro.props;
---

<div>
  <h2>{title}</h2>
</div>
{
  image && (
    <Picture
      src={image}
      alt={imageAlt}
      id="header"
      class="grid-area-full object-cover min-h-[300px]"
      quality={"high"}
      priority
    />
  )
}

<style>
  @reference "../styles/global.css";

  picture {
    display: contents;
  }

  div {
    @apply grid-area-full grid grid-cols-subgrid px-10 mt-[120px] pb-10;

    h2 {
      @apply grid-area-main md:text-center;
    }
  }
</style>
