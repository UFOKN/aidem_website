---
const { label, description, icon } = Astro.props;
import RunnerIcon from "../assets/icons/runner.svg";
import WaveIcon from "../assets/icons/wave.svg";
import GridIcon from "../assets/icons/grid.svg";
import ClockIcon from "../assets/icons/clock-reverse.svg";
import TrendArrowIcon from "../assets/icons/trend-arrow.svg";
import NetworkIcon from "../assets/icons/network.svg";

const icons = {
  runner: RunnerIcon,
  wave: WaveIcon,
  grid: GridIcon,
  clock: ClockIcon,
  trend: TrendArrowIcon,
  network: NetworkIcon,
};

const Icon = icons[icon];
---

<li>
  <Icon />
  <span>{label}</span>
  {description}
</li>

<style>
  @reference "../styles/global.css";

  svg {
    @apply mb-4;
  }

  li {
    @apply list-none flex flex-col items-center py-5 gap-1 text-[var(--color-text-secondary)] text-center text-balance;
  }

  span {
    @apply text-sm uppercase tracking-wider text-[var(--color-text-primary)];
  }
</style>
