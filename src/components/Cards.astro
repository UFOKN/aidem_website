---
import type { ImageMetadata } from "astro";
import Card from "./Card.astro";

interface CardItem {
  title?: string;
  description?: string;
  items?: string[];
  link?: string;
  image?: ImageMetadata;
}

interface Props {
  items: CardItem[];
  cardStyle?: string;
}

const { items, cardStyle } = Astro.props;
---

<ul>
  {items.map((item) => (
    <Card
      title={item.title}
      description={item.description}
      items={item.items}
      link={item.link}
      image={item.image}
      style={cardStyle}
    />
  ))}
</ul>

<style>
  @reference "../styles/global.css";

  ul {
    @apply grid-area-main grid grid-cols-1 md:grid-cols-2 gap-10 auto-rows-fr;
  }
</style>
