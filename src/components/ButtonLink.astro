---
const { href = "#", label, showArrow = true, style = "" } = Astro.props;
import { url } from "../site";
const isExternalLink = href[0] !== "/";
const linkHref = isExternalLink ? href : url(href);
import ArrowIcon from "../assets/icons/arrow.svg";
---

<a href={linkHref} target={isExternalLink ? "_blank" : ""} class={style}>
  {label}
  {showArrow && <ArrowIcon />}
</a>

<style>
  @reference "../styles/global.css";

  a {
    @apply bg-white inline-flex flex-row gap-2 uppercase tracking-wide h-10 w-full md:w-auto whitespace-nowrap justify-center items-center px-3 font-[500] md:ml-auto transition-transform hover:scale-103 hover:opacity-90 ease-in-out;
  }

  svg {
    @apply opacity-50;
  }
</style>
