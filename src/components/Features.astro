---
import Section from "./Section.astro";
import FeatureCard from "./FeatureCard.astro";
import type { ComponentProps } from "astro/types";

const features: ComponentProps<typeof FeatureCard>[] = [
  {
    label: "Speed",
    description: "Ready in minutes",
    icon: "runner",
  },
  {
    label: "Resolution",
    description: "Asset-level",
    icon: "grid",
  },
  {
    label: "Severity",
    description: "From minor to major",
    icon: "trend",
  },
  {
    label: "Impact",
    description: "Track cascading disruptions of flooding",
    icon: "network",
  },
];
---

<Section id="features">
  <ul>
    {features.map((feature) => (
      <FeatureCard
        label={feature.label}
        description={feature.description}
        icon={feature.icon}
      />
    ))}
  </ul>
</Section>

<style>
  @reference "../styles/global.css";

  ul {
    @apply grid-area-main md:grid-area-text mt-20 grid grid-cols-2 md:grid-cols-4 gap-10;
  }
</style>
