---
import Section from "./Section.astro";
---

<Section
  style="bg-[#FFF2C5] dot-grid [--dot-grid-color:#FFC29E] z-2"
  id="use-our-data"
>
  <div id="content-wrapper">
    <h3>Start using our data today</h3>
    <ul>
      <li>
        <h4>APIs</h4>Query our data programatically
      </li>
      <li>
        <h4>LLM</h4>Use natural language
      </li>
      <li>
        <h4>Bespoke solutions</h4>Software tailored to your needs
      </li>
      <li>
        <h4>Enterprise data management</h4>Your data integrated to drive your
        success
      </li>
    </ul>
  </div>
</Section>

<style>
  @reference "../styles/global.css";

  #content-wrapper {
    @apply grid-area-text grid md:grid-cols-2 gap-10 mb-16;
  }

  h3 {
    @apply text-2xl md:text-[3.5rem] lg:text-3xl leading-[115%] font-[400];
    grid-area: initial;
  }

  ul {
    @apply flex flex-col gap-5 md:mt-8;
  }

  li {
    @apply text-[#66614F];
  }

  h4 {
    @apply text-lg text-black;
    font-weight: 400;
  }
</style>
