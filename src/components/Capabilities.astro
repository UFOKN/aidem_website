---
import Section from "./Section.astro";

const capabilities = [
  {
    title: "Flood-Triggered Hazard Modeling",
    description:
      "Physics-based models simulate the hazard chains a flood initiates, including landslides, infrastructure failure and contamination spread.",
  },
  {
    title: "Compound Risk Analysis",
    description:
      "Assess co-occurring and sequentially triggered hazards together, at timescales that support operational decisions.",
  },
  {
    title: "Agentic AI Decision Support",
    description:
      "AI agents synthesize data from multiple sources into decision recommendations for government agencies and emergency managers.",
  },
  {
    title: "Scalable Emergency Response",
    description:
      "Deployable across jurisdictions and hazard types, from a local emergency operations center to regional multi-agency coordination.",
  },
];
---

<Section title="System capabilities" id="capabilities">
  <ul>
    {capabilities.map(({ title, description }) => (
      <li>
        <h4>{title}</h4>
        <p>{description}</p>
      </li>
    ))}
  </ul>
</Section>

<style>
  @reference "../styles/global.css";

  /* The <section> is rendered by Section.astro, outside this component's scope */
  :global(#capabilities) {
    @apply bg-[#FDEBDE] dot-grid [--dot-grid-color:#F2D3BD];
  }

  ul {
    @apply grid-area-main grid grid-cols-1 md:grid-cols-2 gap-10;
  }

  li {
    @apply bg-white p-5 md:p-10 flex flex-col gap-3;
  }

  h4 {
    @apply text-lg md:text-xl;
  }
</style>
